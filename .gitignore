# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/agency-agents-main

# Vendored ONLYOFFICE engine assets (AGPL-3.0, fetched via `npm run vendor:onlyoffice`).
# Large + license-encumbered, so kept out of git. Xenode's own glue files
# (engine.js, editor.html, manifest.json) are committed — reserve them below.
/public/onlyoffice/*
!/public/onlyoffice/engine.js
!/public/onlyoffice/editor.html
!/public/onlyoffice/manifest.json
!/public/onlyoffice/document_editor_service_worker.js

# Local-only reference copies of CryptPad's AGPL offline glue (for porting; never committed).
/.oo-ref/

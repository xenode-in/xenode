# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# turbo
.turbo/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/agency-agents-main
# Generated ONLYOFFICE browser artifacts. Source stays under vendor/onlyoffice.
apps/platform-web/public/internal-editors/onlyoffice/*
!apps/platform-web/public/internal-editors/onlyoffice/README.md
/.artifacts/onlyoffice/
# Transient x2t WASM build context + build log.
/tools/onlyoffice/.x2t-build-context/
/x2t-build.log
# Restricted malicious-file corpus is fetched and deleted by CI.
/.security-corpus/

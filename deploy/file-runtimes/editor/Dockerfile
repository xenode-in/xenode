FROM nginx:1.30-alpine

# The image's entrypoint renders templates into conf.d with the environment.
COPY deploy/file-runtimes/editor/default.conf.template /etc/nginx/templates/default.conf.template
COPY tools/file-runtimes/editor/ /usr/share/nginx/html/
# Generated by `npm run onlyoffice:build-client`; only the README when unbuilt.
COPY apps/drive/public/internal-editors/onlyoffice/ /usr/share/nginx/html/onlyoffice/

EXPOSE 8080

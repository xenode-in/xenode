# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNTS_ORIGIN=http://accounts.localhost:3001
NEXT_PUBLIC_DRIVE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PHOTOS_ORIGIN=http://photos.localhost:3002
NEXT_PUBLIC_OFFICE_EDITOR_ORIGIN=https://edit.xenode.in
# Organizations are fully implemented; this flag gates them at runtime.
# Set both to true to enable the organization plugin + org routes/UI.
ORGS_ENABLED=false
NEXT_PUBLIC_ORGS_ENABLED=false

# Hostile-file runtimes. All renderer approvals fail closed by default.
NEXT_PUBLIC_ONLYOFFICE_EDITOR_ORIGIN=https://edit.xenode.in
NEXT_PUBLIC_ONLYOFFICE_EDITOR_BASE_URL=https://edit.xenode.in/onlyoffice
INSECURE_LOCAL_EDITOR_DEV=false
SAFE_PREVIEW_GLOBAL_ENABLED=false
SAFE_PREVIEW_PDF_ENABLED=false
SAFE_PREVIEW_OFFICE_ENABLED=false
SAFE_PREVIEW_SVG_ENABLED=false
SAFE_PREVIEW_HTML_ENABLED=false
SAFE_PREVIEW_IMAGE_ENABLED=false
SAFE_PREVIEW_MEDIA_ENABLED=false
SAFE_PREVIEW_ARCHIVE_ENABLED=false
SAFE_PREVIEW_TEXT_ENABLED=false
ONLYOFFICE_V2_ENABLED=false

# ─── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/xnode
# Optional separate DB for analytics/logs (recommended)
MONGODB_LOGS_URI=mongodb://localhost:27018/xnode-logs
# Redis for realtime sync pub/sub (Socket.IO fan-out channel)
REDIS_URL=redis://localhost:6379

# ─── Better Auth ──────────────────────────────────────
BETTER_AUTH_SECRET=your_better_auth_secret_here
# Mandatory, independent secrets. Use at least 32 random bytes each.
REALTIME_TICKET_SECRET=
CDN_SIGNING_SECRET=
# Mandatory comma-separated product origins accepted by Socket.IO.
REALTIME_ALLOWED_ORIGIN=https://xenode.in,https://photos.xenode.in

# ─── OAuth (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Backblaze B2 (S3-compatible, one system bucket) ──
S3_BUCKET_NAME=xenode-drive-storage
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_KEY_ID=
S3_APPLICATION_KEY=
PUBLIC_S3_BUCKET=xenopublic

# ─── Admin Panel ──────────────────────────────────────
# Super admin credentials (seeded automatically on first run)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change_me_super_secure_password

# Secret used to sign admin JWT sessions (must be at least 32 chars)
ADMIN_JWT_SECRET=change_me_at_least_32_chars_long_secret

# ─── PostHog (optional) ───────────────────────────────
# If unset, all analytics calls are no-op.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Secret salt for hashing internal user IDs before sending server-side events.
POSTHOG_USER_ID_SALT=change_me_to_a_random_32_plus_char_secret


# RESEND_API_KEY
RESEND_API_KEY=

# CRON_SECRET
CRON_SECRET=

# ─── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_SUBSCRIPTION_WEBHOOK_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

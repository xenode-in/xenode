# Product origins (exact origins; no paths)
ACCOUNTS_ORIGIN=http://localhost:3001
DRIVE_ORIGIN=http://localhost:3000
PHOTOS_ORIGIN=http://localhost:3002
NEXT_PUBLIC_ACCOUNTS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_DRIVE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PHOTOS_ORIGIN=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database and realtime
MONGODB_URI=mongodb://localhost:27017/xenode
MONGODB_LOGS_URI=mongodb://localhost:27017/xenode-logs
REDIS_URL=redis://localhost:6379
REALTIME_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3002

# Generate every secret independently. Production values must be 32+ random
# characters; BETTER_AUTH, ADMIN, realtime, CDN, and cron secrets must not match.
BETTER_AUTH_SECRET=replace_with_independent_random_secret_1
ADMIN_JWT_SECRET=replace_with_independent_random_secret_2
REALTIME_TICKET_SECRET=replace_with_independent_random_secret_3
CDN_SIGNING_SECRET=replace_with_independent_random_secret_4
CRON_SECRET=replace_with_independent_random_secret_5

# Accounts authentication (optional OAuth providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Backblaze B2 / S3-compatible system bucket
S3_BUCKET_NAME=xenode-drive-storage
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_KEY_ID=
S3_APPLICATION_KEY=
PUBLIC_S3_BUCKET=
PUBLIC_S3_ENDPOINT=
AZURE_CDN_URL=

# Organizations
ORGS_ENABLED=false
NEXT_PUBLIC_ORGS_ENABLED=false

# Static-only Office editor runtime
NEXT_PUBLIC_OFFICE_EDITOR_ORIGIN=https://edit.xenode.in
NEXT_PUBLIC_ONLYOFFICE_EDITOR_ORIGIN=https://edit.xenode.in
NEXT_PUBLIC_ONLYOFFICE_EDITOR_BASE_URL=https://edit.xenode.in/onlyoffice
NEXT_PUBLIC_ONLYOFFICE_ARTIFACT_VERSION=9.3.0.140-cryptpad.2-xenode.1
NEXT_PUBLIC_OFFICE_EDITOR_MAX_BYTES=78643200
NEXT_PUBLIC_OFFICE_EDITOR_MAX_BIN_BYTES=314572800
NEXT_PUBLIC_OFFICE_EDITOR_MAX_BRIDGE_BYTES=314572800
NEXT_PUBLIC_OFFICE_EDITOR_MAX_FONTS=60
INSECURE_LOCAL_EDITOR_DEV=false

# Hostile-file renderer approvals fail closed by default
SAFE_PREVIEW_GLOBAL_ENABLED=false
SAFE_PREVIEW_PDF_ENABLED=false
SAFE_PREVIEW_OFFICE_ENABLED=false
SAFE_PREVIEW_SVG_ENABLED=false
SAFE_PREVIEW_HTML_ENABLED=false
SAFE_PREVIEW_IMAGE_ENABLED=false
SAFE_PREVIEW_MEDIA_ENABLED=false
SAFE_PREVIEW_ARCHIVE_ENABLED=false
SAFE_PREVIEW_TEXT_ENABLED=false
ONLYOFFICE_V2_ENABLED=false

# Drive admin bootstrap
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NOTIFY_EMAIL=

# Email
RESEND_API_KEY=
EMAIL_FROM=Xenode <no-reply@example.com>

# Razorpay subscriptions
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RZP_ORG_STARTER_MONTHLY=
RZP_ORG_STARTER_YEARLY=
RZP_ORG_TEAM_MONTHLY=
RZP_ORG_TEAM_YEARLY=
RZP_ORG_BUSINESS_MONTHLY=
RZP_ORG_BUSINESS_YEARLY=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_USER_ID_SALT=replace_with_an_independent_random_salt
